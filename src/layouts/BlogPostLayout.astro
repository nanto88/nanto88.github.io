---
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import ArticleMeta from '../components/ArticleMeta.astro';
import { formatDate } from '../lib/blog';

interface Props {
  title: string;
  description: string;
  category: string;
  tags: string[];
  pubDate: Date;
  updatedDate?: Date;
  readingTime: string;
  toc?: MarkdownHeading[];
  related?: CollectionEntry<'blog'>[];
  /** must match the ArticleCard heading on the list page for the title morph */
  transitionName?: string;
}

const {
  title,
  description,
  category,
  tags,
  pubDate,
  updatedDate,
  readingTime,
  toc = [],
  related = [],
  transitionName,
} = Astro.props;
---

<BaseLayout title={title} description={description} type="article">
  <div class="reading-progress"></div>

  <article class="mx-auto max-w-[760px] px-6 py-12">
    <a href="/" class="meta-mono text-[11px] text-[var(--color-text-muted)] no-underline hover:text-[var(--color-accent-bright)] hover:no-underline">
      ../home
    </a>

    <h1
      class="mt-6 text-2xl leading-snug font-bold text-balance text-[var(--color-heading)] sm:text-3xl"
      transition:name={transitionName}
    >
      <span class="text-[var(--color-prompt)]">#&nbsp;</span>{title}
    </h1>

    <p class="mt-4 max-w-[680px] text-sm leading-relaxed text-[var(--color-text-secondary)]">{description}</p>

    <div class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-1">
      <ArticleMeta category={category} date={pubDate} readingTime={readingTime} size="lg" />
      {updatedDate && (
        <span class="meta-mono text-xs">· updated {formatDate(updatedDate)}</span>
      )}
      <button
        type="button"
        data-read-toggle
        class="read-toggle meta-mono ml-auto cursor-pointer text-xs hover:text-[var(--color-accent-bright)]"
        title="Warm colours, no blue tones, roomier text"
      >
        <span class="read-off">[ ] read mode</span><span class="read-on">[x] read mode</span>
      </button>
    </div>

    <hr class="rule my-8" />

    {toc.length > 0 && (
      <details class="toc mb-10 max-w-[680px] xl:hidden border border-dashed border-[var(--color-border)] p-4 text-sm">
        <summary class="meta-mono text-[11px] text-[var(--color-text-secondary)]">contents</summary>
        <ol class="mt-3 space-y-1.5">
          {toc.map((heading, i) => (
            <li class="flex gap-2">
              <span class="meta-mono text-[11px] text-[var(--color-text-muted)]">
                {String(i + 1).padStart(2, '0')}
              </span>
              <a href={`#${heading.slug}`} class="no-underline hover:underline">{heading.text}</a>
            </li>
          ))}
        </ol>
      </details>
    )}

    {toc.length > 0 && (
      // Wide screens only: sits in the right margin beside the 3xl column and stays put
      // while scrolling. The script marks the link of the heading being read.
      <nav
        class="toc-float fixed top-24 left-1/2 ml-[25.5rem] hidden max-h-[calc(100vh-8rem)] w-52 overflow-y-auto text-[11px] leading-snug xl:block"
        aria-label="Contents"
      >
        <p class="meta-mono mb-3 text-[11px]">contents</p>
        <ol class="space-y-1 border-l border-dashed border-[var(--color-border)]">
          {toc.map((heading) => (
            <li>
              <a
                href={`#${heading.slug}`}
                class="toc-link block py-1 pl-3 text-[var(--color-text-muted)] no-underline hover:text-[var(--color-accent-bright)] hover:no-underline"
              >
                {heading.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    )}

    <div class="article-body">
      <slot />
    </div>

    {tags.length > 0 && (
      <>
        <hr class="rule my-10" />
        <div class="flex flex-wrap gap-x-4 gap-y-2">
          {tags.map((tag) => (
            <a
              href={`/tag/${tag}/`}
              class="meta-mono text-[11px] text-[var(--color-text-secondary)] no-underline hover:text-[var(--color-accent-bright)] hover:no-underline"
            >
              #{tag}
            </a>
          ))}
        </div>
      </>
    )}

    {related.length > 0 && (
      <section class="mt-14 border-t border-dashed border-[var(--color-border)] pt-6">
        <p class="meta-mono text-[11px] text-[var(--color-text-muted)]">Read next</p>
        <ul class="mt-4 space-y-4">
          {related.map((next) => (
            <li>
              <a href={`/blog/${next.id}/`} class="text-sm no-underline hover:underline">
                <span class="text-[var(--color-prompt)]">→ </span>{next.data.title}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <button type="button" class="to-top meta-mono text-[11px]" aria-label="Back to top">[↑ top]</button>
  </article>
</BaseLayout>

<script>
  // ClientRouter swaps the DOM on navigation, so this work is re-run per page via
  // astro:page-load (which also fires on the initial load) rather than at module scope.
  let bar: HTMLElement | null = null;
  let toTop: HTMLElement | null = null;
  // [heading, its link in the floating contents] pairs, in document order
  let spy: [HTMLElement, Element][] = [];
  let current: Element | null = null;

  // Reading progress bar — scaleX tracks how far down the document we are.
  const update = () => {
    if (!bar) return;
    const max = document.documentElement.scrollHeight - window.innerHeight;
    bar.style.transform = `scaleX(${max > 0 ? window.scrollY / max : 0})`;
    toTop?.classList.toggle('is-shown', window.scrollY > window.innerHeight);

    // Scroll-spy: the current section is the last heading that has reached the top
    // third of the viewport. At the very bottom, short last sections would never get
    // there, so the final heading wins instead.
    if (!spy.length) return;
    const line = window.innerHeight / 3;
    const atEnd = window.scrollY >= max - 2;
    let active = spy[0][1];
    for (const [heading, link] of spy) {
      if (!atEnd && heading.getBoundingClientRect().top > line) break;
      active = link;
    }
    if (active === current) return;
    current?.removeAttribute('aria-current');
    active.setAttribute('aria-current', 'location');
    current = active;
  };

  // Bound once at module scope: re-binding the same reference would be a no-op anyway,
  // but keeping it out of the per-page handler makes that guarantee explicit.
  addEventListener('scroll', update, { passive: true });
  addEventListener('resize', update, { passive: true });

  // Wrap each sentence in a span so CSS can highlight the one under the pointer.
  // Guards, in order: no split after a single-letter abbreviation ("e.g.", "U.S."),
  // and only split when the next sentence starts non-lowercase — keeps "3.5" intact too.
  // ponytail: heuristic, not a real tokenizer. Swap in Intl.Segmenter if it ever misreads prose.
  const SENTENCES = /[\s\S]*?(?<![\s.][A-Za-z])[.!?…]["')\]]?(?=\s+(?![a-z])|\s*$)\s*|[\s\S]+$/g;

  function wrapSentences() {
    for (const block of document.querySelectorAll('.article-body p, .article-body li')) {
      // already processed (defensive — a re-fired page-load must not double-wrap)
      if (block.querySelector('.sentence') || block.querySelector('img')) continue;

      const wrapped: Node[] = [];
      let current: HTMLSpanElement | null = null;

      const open = () => {
        current = document.createElement('span');
        current.className = 'sentence';
        wrapped.push(current);
        return current;
      };

      for (const node of [...block.childNodes]) {
        if (node.nodeType === Node.TEXT_NODE) {
          for (const part of node.textContent?.match(SENTENCES) ?? []) {
            (current ?? open()).append(part);
            if (/[.!?…]["')\]]?\s*$/.test(part)) current = null;
          }
        } else {
          // whole inline elements (<code>, <strong>, <a>) join the sentence in progress
          (current ?? open()).append(node);
        }
      }

      block.replaceChildren(...wrapped);
    }
  }

  document.addEventListener('astro:page-load', () => {
    bar = document.querySelector<HTMLElement>('.reading-progress');
    toTop = document.querySelector<HTMLElement>('.to-top');
    // smooth or instant follows the page's scroll-behavior (reduced motion turns it off)
    toTop?.addEventListener('click', () => scrollTo({ top: 0 }));
    current = null;
    spy = [...document.querySelectorAll<HTMLAnchorElement>('.toc-float .toc-link')].flatMap((link) => {
      const heading = document.getElementById(link.hash.slice(1));
      return heading ? [[heading, link] as [HTMLElement, Element]] : [];
    });
    update();
    wrapSentences();
  });
</script>
