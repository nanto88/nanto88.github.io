---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SOCIAL } from '../config';
---

<BaseLayout title="About">
  <div class="mx-auto max-w-3xl px-6 py-14">
    <h1 class="prompt text-xl font-bold sm:text-2xl">cat about.md</h1>
    <div class="article-body mt-8">
      <p>
        Hi, I'm Experienced backend-focused software engineer with 7+ years in the tech industry. Skilled in building scalable
        systems, resilient applications, and optimizations. Experienced track record in SaaS, e-commerce, government
        sectors and software house as researcher. Turns out from ML research engineer 1y7m to software engineering
      </p>
      <p>
        Find me on <a href={SOCIAL.github}>GitHub</a>{SOCIAL.linkedin && <> and <a href={SOCIAL.linkedin}>LinkedIn</a></>}.
      </p>
    </div>
  </div>
</BaseLayout>
