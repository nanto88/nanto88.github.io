---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { publishedPosts, sortByDateDesc } from '../../lib/blog';

export async function getStaticPaths() {
  const posts = publishedPosts(await getCollection('blog'));
  const tags = [...new Set(posts.flatMap((post) => post.data.tags))];

  return tags.map((tag) => ({
    params: { tag },
    props: { posts: sortByDateDesc(posts.filter((post) => post.data.tags.includes(tag))) },
  }));
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---

<BaseLayout title={`#${tag}`}>
  <div class="mx-auto max-w-3xl px-6 py-14">
    <h1 class="prompt text-xl font-bold sm:text-2xl">grep -r "#{tag}"</h1>
    <div class="mt-8 divide-y divide-dashed divide-[var(--color-border)]">
      {posts.map((post) => <ArticleCard post={post} />)}
    </div>
  </div>
</BaseLayout>
