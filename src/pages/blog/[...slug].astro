---
import { getCollection, render } from 'astro:content';
import BlogPostLayout from '../../layouts/BlogPostLayout.astro';
import { readingTime, publishedPosts, relatedPosts } from '../../lib/blog';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const published = publishedPosts(posts);
  return published.map((post) => ({
    params: { slug: post.id },
    props: { post, related: relatedPosts(post, published) },
  }));
}

const { post, related } = Astro.props;
const { Content, headings } = await render(post);
const minutesRead = readingTime(post.body ?? '');

// Only worth a TOC once there's enough to navigate
const toc = headings.filter((h) => h.depth === 2);
---

<BlogPostLayout
  title={post.data.title}
  description={post.data.description}
  category={post.data.category}
  tags={post.data.tags}
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  readingTime={minutesRead}
  toc={toc.length >= 3 ? toc : []}
  related={related}
  transitionName={`post-${post.id}`}
>
  <Content />
</BlogPostLayout>
