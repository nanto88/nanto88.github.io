---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { SITE, SOCIAL } from '../config';
import { publishedPosts, sortByDateDesc } from '../lib/blog';

const byDate = sortByDateDesc(publishedPosts(await getCollection('blog')));
const featured = byDate.find((post) => post.data.featured);
// The featured post leads the list instead of sitting in its own block above
// the filter, so the filter always describes everything below it.
const allPosts = featured ? [featured, ...byDate.filter((post) => post !== featured)] : byDate;

// One topic dimension: category + tags. Every post has a category, so nothing
// falls out of the filter even when tags are missing.
const topicsOf = (post: (typeof allPosts)[number]) => [
  ...new Set([post.data.category, ...post.data.tags]),
];

const count = new Map<string, number>();
for (const post of allPosts) {
  for (const topic of new Set(topicsOf(post))) count.set(topic, (count.get(topic) ?? 0) + 1);
}

const categories = [...new Set(allPosts.map((post) => post.data.category))].sort();
const byUse = [...new Set(allPosts.flatMap((post) => post.data.tags))]
  .filter((tag) => !categories.includes(tag))
  .sort((a, b) => count.get(b)! - count.get(a)! || a.localeCompare(b));
// Tags used once would double the chip row for nothing, so they sit behind a
// disclosure instead of being dropped.
const tags = byUse.filter((tag) => count.get(tag)! > 1);
const rareTags = byUse.filter((tag) => count.get(tag)! === 1);
const years = [...new Set(allPosts.map((post) => post.data.pubDate.getFullYear()))].sort(
  (a, b) => b - a,
);

const chip =
  'meta-mono border border-[var(--color-border)] px-2 py-1 text-[11px] text-[var(--color-text-muted)] transition-colors hover:border-[var(--color-accent)] hover:text-[var(--color-accent-bright)] aria-pressed:border-[var(--color-accent)] aria-pressed:bg-[var(--color-surface-elevated)] aria-pressed:text-[var(--color-accent-bright)]';
---

<BaseLayout title={SITE.title}>
  <div class="mx-auto max-w-3xl px-6 py-14">
    <p class="meta-mono text-[11px]">software engineer · ai · backend</p>
    <h1 class="prompt caret mt-4 text-xl leading-relaxed font-bold sm:text-2xl">
      {SITE.description}
    </h1>
    <div class="mt-6 flex gap-4 text-xs">
      <a href={SOCIAL.github}>github</a>
      {SOCIAL.linkedin && <a href={SOCIAL.linkedin}>linkedin</a>}
      <a href="/rss.xml">rss</a>
    </div>

    <section class="mt-14" data-filters>
      <p class="meta-mono text-[11px] text-[var(--color-text-muted)]">// filter</p>

      <p class="mt-2 overflow-x-auto text-xs whitespace-nowrap text-[var(--color-text-secondary)]">
        <span class="text-[var(--color-prompt)]">$</span> ls ./blog <span
          class="text-[var(--color-accent-bright)]"
          data-echo="topic">--topic=all</span
        > <span class="text-[var(--color-accent-bright)]" data-echo="year">--year=all</span>
      </p>

      <div class="mt-4 flex flex-wrap items-center gap-2">
        <span class="meta-mono w-12 text-[11px]">topic</span>
        <button type="button" class={chip} data-filter="topic" data-value="" aria-pressed="true">all</button>
        {categories.map((category) => (
          <button type="button" class={chip} data-filter="topic" data-value={category} aria-pressed="false">
            [{category}]<span class="opacity-50"> {count.get(category)}</span>
          </button>
        ))}
        {tags.map((tag) => (
          <button type="button" class={chip} data-filter="topic" data-value={tag} aria-pressed="false">
            #{tag}<span class="opacity-50"> {count.get(tag)}</span>
          </button>
        ))}
      </div>

      {rareTags.length > 0 && (
        <details class="disclosure mt-2 pl-14">
          <summary class="meta-mono text-[11px] text-[var(--color-text-muted)] transition-colors hover:text-[var(--color-accent-bright)]">
            {rareTags.length} more tags
          </summary>
          <div class="flex flex-wrap gap-2 pt-2">
            {rareTags.map((tag, i) => (
              <button
                type="button"
                class={`${chip} chip-in`}
                style={`--i:${i}`}
                data-filter="topic"
                data-value={tag}
                aria-pressed="false"
              >
                #{tag}
              </button>
            ))}
          </div>
        </details>
      )}

      <div class="mt-2 flex flex-wrap items-center gap-2">
        <span class="meta-mono w-12 text-[11px]">year</span>
        <button type="button" class={chip} data-filter="year" data-value="" aria-pressed="true">all</button>
        {years.map((year) => (
          <button type="button" class={chip} data-filter="year" data-value={String(year)} aria-pressed="false">
            {year}
          </button>
        ))}
      </div>

      <p class="meta-mono mt-4 text-[11px]" aria-live="polite" data-count>{allPosts.length} posts</p>
    </section>

    <section class="mt-2">
      <div class="divide-y divide-dashed divide-[var(--color-border)]">
        {allPosts.map((post) => (
          <div
            data-post
            data-topics={topicsOf(post).join(' ')}
            data-year={post.data.pubDate.getFullYear()}
          >
            {post.id === featured?.id && (
              <p class="meta-mono pt-6 text-[11px] text-[var(--color-prompt)]">// featured</p>
            )}
            <ArticleCard post={post} />
          </div>
        ))}
      </div>
      <p class="mt-6 text-xs text-[var(--color-text-secondary)]" data-empty hidden>
        <span class="text-[var(--color-prompt)]">&gt;</span> no posts match that filter. try
        <button type="button" class="underline text-[var(--color-accent-bright)]" data-reset>clearing it</button>.
      </p>
    </section>
  </div>
</BaseLayout>

<script>
  // Filtering runs in the browser: the site is static, and a few rows of DOM
  // beat generating a route for every tag and year combination.
  function initFilters() {
    const bar = document.querySelector<HTMLElement>('[data-filters]');
    if (!bar) return;

    const rows = [...document.querySelectorAll<HTMLElement>('[data-post]')];
    const countEl = document.querySelector<HTMLElement>('[data-count]');
    const emptyEl = document.querySelector<HTMLElement>('[data-empty]');

    const params = new URLSearchParams(location.search);
    const state = {
      topic: params.get('topic') ?? '',
      year: params.get('year') ?? '',
    };

    function apply() {
      const matched = new Set(
        rows.filter(
          (row) =>
            (!state.topic || (row.dataset.topics ?? '').split(' ').includes(state.topic)) &&
            (!state.year || row.dataset.year === state.year),
        ),
      );

      for (const row of rows) row.hidden = !matched.has(row);
      if (emptyEl) emptyEl.hidden = matched.size > 0;
      if (countEl) countEl.textContent = `${matched.size} post${matched.size === 1 ? '' : 's'}`;

      for (const button of bar!.querySelectorAll<HTMLButtonElement>('[data-filter]')) {
        const key = button.dataset.filter as 'topic' | 'year';
        button.setAttribute('aria-pressed', String(state[key] === button.dataset.value));
      }
      for (const echo of document.querySelectorAll<HTMLElement>('[data-echo]')) {
        const key = echo.dataset.echo as 'topic' | 'year';
        echo.textContent = `--${key}=${state[key] || 'all'}`;
      }

      // Shareable state, and it survives a back/forward without a rebuild.
      const next = new URLSearchParams();
      if (state.topic) next.set('topic', state.topic);
      if (state.year) next.set('year', state.year);
      const query = next.toString();
      history.replaceState({}, '', query ? `?${query}` : location.pathname);
    }

    bar.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-filter]');
      if (!button) return;
      const key = button.dataset.filter as 'topic' | 'year';
      // clicking the active chip clears it
      state[key] = state[key] === button.dataset.value ? '' : (button.dataset.value ?? '');
      apply();
    });

    document.querySelector('[data-reset]')?.addEventListener('click', () => {
      state.topic = '';
      state.year = '';
      apply();
    });

    apply();
  }

  // ClientRouter keeps module scripts from re-running, so hook the page event.
  document.addEventListener('astro:page-load', initFilters);
</script>
