---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { SITE, SOCIAL } from '../config';
import { publishedPosts, sortByDateDesc } from '../lib/blog';

const allPosts = sortByDateDesc(publishedPosts(await getCollection('blog')));
const featured = allPosts.find((post) => post.data.featured) ?? allPosts[0];
const latest = allPosts.filter((post) => post.id !== featured?.id).slice(0, 5);
const categories = [...new Set(allPosts.map((post) => post.data.category))];
---

<BaseLayout title={SITE.title}>
  <div class="mx-auto max-w-3xl px-6 py-14">
    <p class="meta-mono text-[11px]">software engineer · ai · backend</p>
    <h1 class="prompt caret mt-4 text-xl leading-relaxed font-bold sm:text-2xl">
      {SITE.description}
    </h1>
    <div class="mt-6 flex gap-4 text-xs">
      <a href={SOCIAL.github}>github</a>
      {SOCIAL.linkedin && <a href={SOCIAL.linkedin}>linkedin</a>}
      <a href="/rss.xml">rss</a>
    </div>

    {featured && (
      <section class="mt-14">
        <p class="meta-mono text-[11px] text-[var(--color-text-muted)]">// featured</p>
        <div class="mt-2 border-b border-dashed border-[var(--color-border)] pb-6">
          <ArticleCard post={featured} />
        </div>
      </section>
    )}

    {latest.length > 0 && (
      <section class="mt-6">
        <p class="meta-mono text-[11px] text-[var(--color-text-muted)]">// latest</p>
        <div class="divide-y divide-dashed divide-[var(--color-border)]">
          {latest.map((post) => <ArticleCard post={post} />)}
        </div>
        <a href="/blog/" class="text-xs">→ all posts</a>
      </section>
    )}

    {categories.length > 0 && (
      <section class="mt-12 border-t border-dashed border-[var(--color-border)] pt-6">
        <p class="meta-mono text-[11px] text-[var(--color-text-muted)]">// topics</p>
        <div class="mt-3 flex flex-wrap gap-x-4 gap-y-2">
          {categories.map((category) => (
            <a
              href={`/category/${category}/`}
              class="meta-mono text-[11px] text-[var(--color-text-secondary)] no-underline hover:text-[var(--color-accent-bright)] hover:no-underline"
            >
              <span class="text-[var(--color-border)]">[</span>{category}<span class="text-[var(--color-border)]">]</span>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>
