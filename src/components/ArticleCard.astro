---
import type { CollectionEntry } from 'astro:content';
import ArticleMeta from './ArticleMeta.astro';
import { readingTime } from '../lib/blog';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const minutesRead = readingTime(post.body ?? '');
---

<article class="group py-6">
  <ArticleMeta category={post.data.category} date={post.data.pubDate} readingTime={minutesRead} />
  <h3 class="mt-2 text-base font-bold sm:text-lg">
    <a
      href={`/blog/${post.id}/`}
      class="text-[var(--color-text)] no-underline hover:text-[var(--color-accent-bright)] hover:no-underline"
    >
      <span class="text-[var(--color-prompt)] opacity-0 transition-opacity group-hover:opacity-100">&gt;&nbsp;</span
      >{post.data.title}
    </a>
  </h3>
  <p class="mt-2 text-sm leading-relaxed text-[var(--color-text-secondary)]">{post.data.description}</p>
</article>
