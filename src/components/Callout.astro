---
interface Props {
  type?: 'info' | 'warning' | 'success' | 'danger' | 'tip';
}

const { type = 'info' } = Astro.props;

const colors: Record<string, string> = {
  info: 'var(--color-accent)',
  tip: 'var(--color-accent)',
  success: '#3fb950',
  warning: '#d29922',
  danger: '#f85149',
};

const labels: Record<string, string> = {
  info: 'Info',
  tip: 'Tip',
  success: 'Success',
  warning: 'Warning',
  danger: 'Danger',
};
---

<div
  class="not-prose my-6 rounded-md border-l-2 bg-[var(--color-surface-elevated)] px-4 py-3 font-[family-name:var(--font-ui)] text-[15px]"
  style={`border-color: ${colors[type]}`}
>
  <p class="meta-mono mb-1 text-xs" style={`color: ${colors[type]}`}>{labels[type]}</p>
  <div class="text-[var(--color-text-secondary)]">
    <slot />
  </div>
</div>
